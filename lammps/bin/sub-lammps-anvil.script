#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=standard

#######################################################################
module rm gcc mvapich2 openmpi
module add gcc/11.2.0 openmpi/4.0.6 fftw/3.3.8
module add python

MPIRUN='srun -c 1 --cpu_bind=cores --mpi=pmi2 -n'
# The code files are group accessible
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/home/x-baip/tools/lammps/gcc-ompi-fftw3/lib64"
PROG="/home/x-baip/tools/lammps/gcc-ompi-fftw3/bin/lmp"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-lammps.script

exit 0
