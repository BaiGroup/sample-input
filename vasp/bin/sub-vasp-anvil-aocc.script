#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=standard

#######################################################################
module rm aocc mvapich2 openmpi hdf5
module add aocc/3.1.0 openmpi/4.0.6

MPIRUN='srun -c 1 --cpu_bind=cores --mpi=pmi2 -n'
# The code files are group accessible
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/home/x-baip/tools/aocc/ompd:/home/x-baip/tools/aocc/lib:/home/x-baip/tools/aocc/lib32:/home/x-baip/tools/aocl/aocc-3.2.0/lib:/apps/spack/anvil/apps/hdf5/1.10.7-aocc-3.1.0-xtrqbkt/lib"
PROG="/home/x-baip/vasp-tools/hosts/anvil/vaspexec/vasp6.3.2_aocc_ompi_aocl_vtst"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
