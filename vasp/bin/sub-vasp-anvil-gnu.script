#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=standard

#######################################################################
module rm gcc mvapich2 openmpi hdf5
module add gcc/11.2.0 openmpi/4.0.6 hdf5/1.10.7

MPIRUN='srun -c 1 --cpu_bind=cores --mpi=pmi2 -n'
# The code files are group accessible
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/home/x-baip/tools/aocl/gcc-3.2.0/lib"
PROG="/home/x-baip/vasp-tools/hosts/anvil/vaspexec/vasp6.3.2_gnu_ompi_aocl_vtst"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
