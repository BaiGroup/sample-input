#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=40
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=cpu

#######################################################################
source /etc/profile
ulimit -s unlimited
[ -d "$HOME/privatemodules"  ] && module use --append ~/privatemodules
module add intel-oneapi-compilers/2021.4.0 intel-oneapi-mpi/2021.6.0 mkl/2022.3.1

if lscpu | grep 'Model name:' | grep -q 'EPYC'; then
  export MKL_DEBUG_CPU_TYPE=5
  export MKL_ENABLE_INSTRUCTIONS=AVX2
fi

MPIRUN='mpirun -np'
PROG="$HOME/vasp-tools/hosts/unity/vaspexec/vasp6.1.2_ifort_impi_mkl_vtst"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
