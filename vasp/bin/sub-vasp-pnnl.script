#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --account=st48722

#######################################################################
module rm intel impi ompi python gcc cray-mpich/7.6.0 cray-libsci
# module add python/conda3
# module add gcc/6.3.0
module add intel/18.0.0.128
module add impi/2017.up2

export I_MPI_FABRICS=ofi
export I_MPI_OFI_PROVIDER=gni
export I_MPI_OFI_DIRECT_RMA=1
export I_MPI_OFI_LIBRARY=/usr/common/software/libfabric/1.5.0/gnu/lib/libfabric.so
export I_MPI_PMI_LIBRARY=/usr/lib64/slurmpmi/libpmi.so

PROG="/global/homes/b/baip/vasp-tools/hosts/edison/vaspexec/vasp5.4.1_ifort_impi_mkl_vtst_vaspsol"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
ldd "$PROG" > ldd.txt
source sub-vasp.script

exit 0
