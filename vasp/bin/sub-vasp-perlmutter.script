#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=96:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --qos=regular

#######################################################################
module rm PrgEnv-cray PrgEnv-gnu PrgEnv-aocc PrgEnv-nvidia PrgEnv-nvhpc
module add PrgEnv-gnu/8.3.3 cray-fftw/3.3.8.13 cray-hdf5/1.12.1.1

MPIRUN='srun -c 1 --cpu_bind=cores -n'
PROG="/global/common/software/m3393/vasp-tools/hosts/perlmutter/vaspexec/vasp6.3.2_gnu_mpich_libsci_fftw_vtst"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
