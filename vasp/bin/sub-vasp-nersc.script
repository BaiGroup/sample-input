#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=48
##SBATCH --mem=0
#SBATCH --time=96:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=regular
#SBATCH --license=SCRATCH

#######################################################################
module rm python PrgEnv-cray PrgEnv-gnu PrgEnv-intel
module add PrgEnv-intel
module rm cray-libsci

MPIRUN='srun -c 1 --cpu_bind=cores -n'

if lscpu | grep -q 'Xeon Phi' &> /dev/null; then
    # knl
    module swap craype-haswell craype-mic-knl
    PROG="/global/common/software/m3393/vasp-tools/hosts/cori-knl/vaspexec/vasp5.4.1_ifort_mpich_mkl_vtst_vaspsol"
elif lscpu | grep -q ' v3 @ ' &> /dev/null; then
    # cori
    PROG="/global/common/software/m3393/vasp-tools/hosts/cori/vaspexec/vasp5.4.1_ifort_mpich_mkl_vtst_vaspsol"
else
    # edison
    PROG="/global/common/software/m3393/vasp-tools/hosts/edison/vaspexec/vasp5.4.1_ifort_mpich_mkl_vtst_vaspsol"
fi

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
