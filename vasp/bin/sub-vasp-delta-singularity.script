#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
##SBATCH --mem=0
#SBATCH --time=24:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=cpu
#SBATCH --account=bbwx-delta-cpu
#SBATCH --constraint="scratch"

#######################################################################
sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
MPIRUN="$ROOT/run_singularity.sh"

# The code files are group accessible
if [ $ngpupernode -eq 0 ]; then
  # CPU-only executable
  SINGULARITY_IMAGE='/taiga/nsf/delta/bbwx/shared/tools/singularity/compiler_aocc-slurm-pmi-spack.sif'
  PROG='/taiga/nsf/delta/bbwx/shared/vasp-tools/hosts/docker/vaspexec/vasp6.3.2_aocc_ompi_aocl_vtst_slurm_pmi'

  cat << EOF > $MPIRUN
#!/usr/bin/env bash

srun -c 1 --cpu_bind=cores --mpi=pmi2 -n \$1 singularity exec --bind /scratch,/taiga/nsf/delta/bbwx $SINGULARITY_IMAGE "\${@:2}"
EOF
else
  # GPU-enabled executable
  SINGULARITY_IMAGE='/taiga/nsf/delta/bbwx/shared/tools/singularity/compiler_nvhpc-cuda-slurm-pmi-spack.sif'
  PROG='/taiga/nsf/delta/bbwx/shared/vasp-tools/hosts/docker/vaspexec/vasp6.3.2_nvhpc_ompi_omp_acc_vtst_slurm_pmi'

  cat << EOF > $MPIRUN
#!/usr/bin/env bash

nprocpergpu=\$((\$1/$ngpuperjob))
export OMP_NUM_THREADS=\$nprocpergpu
export OMP_STACKSIZE=512m
export OMP_PLACES=cores
export OMP_PROC_BIND=close
srun -c 1 --cpu_bind=cores --mpi=pmi2 -n $ngpuperjob singularity exec --nv --bind /scratch,/taiga/nsf/delta/bbwx $SINGULARITY_IMAGE "\${@:2}"
EOF
fi

chmod +x $MPIRUN
#######################################################################
source sub-vasp.script

exit 0
