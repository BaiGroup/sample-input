#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=40
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=cpu

#######################################################################
source /etc/profile
ulimit -s unlimited
[ -d '/work/pi_pengbai_umass_edu/unitymodules' ] && module use --append /work/pi_pengbai_umass_edu/unitymodules
module add apptainer/latest openmpi/4.1.6

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
MPIRUN="$ROOT/run_singularity.sh"

# The code files are group accessible
if [ $ngpupernode -eq 0 ]; then
  # CPU-only executable
  SINGULARITY_IMAGE='/work/pi_pengbai_umass_edu/singularity/compiler_aocc-spack.sif'
  PROG='/work/pi_pengbai_umass_edu/vasp-tools/hosts/docker/vaspexec/vasp6.3.2_aocc_ompi_aocl_vtst'

  cat << EOF > $MPIRUN
#!/usr/bin/env bash

mpirun -np \$1 apptainer exec --bind $TMP,/work/$USER,/work/pi_pengbai_umass_edu $SINGULARITY_IMAGE "\${@:2}"
EOF
else
  # GPU-enabled executable
  SINGULARITY_IMAGE='/work/pi_pengbai_umass_edu/singularity/compiler_nvhpc-cuda-spack.sif'
  PROG='/work/pi_pengbai_umass_edu/vasp-tools/hosts/docker/vaspexec/vasp6.3.2_nvhpc_ompi_omp_acc_vtst'

  cat << EOF > $MPIRUN
#!/usr/bin/env bash

nprocpergpu=\$((\$1/$ngpuperjob))
export OMP_NUM_THREADS=\$nprocpergpu
export OMP_STACKSIZE=512m
export OMP_PLACES=cores
export OMP_PROC_BIND=close
mpirun -np $ngpuperjob --map-by socket --bind-to core apptainer exec --nv --bind $TMP,/work/$USER,/work/pi_pengbai_umass_edu $SINGULARITY_IMAGE "\${@:2}"
EOF
fi

chmod +x $MPIRUN
#######################################################################
source sub-vasp.script

exit 0
