#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=48
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=skx-normal

#######################################################################
module rm intel impi
module add intel/18.0.2 impi/18.0.2

export PATH=$(echo $PATH | sed -e 's/:\.:/:/g' -e 's/:\.$//g' -e 's/^.:/:/')

MPIRUN='ibrun -np'
PROG="$HOME/vasp-tools/hosts/stampede2/vaspexec/vasp6.1.2_ifort_impi_mkl_vtst"
#PROG="$HOME/vasp-tools/hosts/stampede2-knl/vaspexec/vasp5.4.1_ifort_impi_mkl_vtst_vaspsol"

if [ "$HOSTS" ]; then
  ROOT=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
else
  WALLTIME=$(scontrol show job $SLURM_JOB_ID | gawk '/TimeLimit/{seconds=0; split($2,t1,"="); if (split(t1[2],t2,"-")==2) {seconds=t2[1]*24; t2[1]=t2[2];} split(t2[1],t3,":"); print ((seconds+t3[1])*60+t3[2])*60+t3[3]}')
  NODE=($(scontrol show hostname "$SLURM_NODELIST"))
  #echo ${NODE[@]} > tmp-$PBS_JOBID
  HOSTS=${NODE[@]}
  ROOT=$SLURM_SUBMIT_DIR
  nprocpernode=$((SLURM_NTASKS_PER_NODE*SLURM_CPUS_PER_TASK))
fi
#######################################################################
cd "$ROOT"
source sub-vasp.script

exit 0
