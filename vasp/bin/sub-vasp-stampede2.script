#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=48
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=skx-normal

#######################################################################
module rm intel impi mvapich2 hdf5
module add intel/18.0.2 impi/18.0.2 hdf5/1.10.4

export PATH=$(echo $PATH | sed -e 's/:\.:/:/g' -e 's/:\.$//g' -e 's/^.:/:/')

MPIRUN='ibrun -np'
PROG="$HOME/vasp-tools/hosts/stampede2/vaspexec/vasp6.3.2_intel_impi_mkl_vtst"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
