#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=96:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --qos=regular

#######################################################################
module rm cray-mpich

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
MPIRUN="$ROOT/run_shifter.sh"
nprocperjob=16
ngpuperjob=1
export MPIRUN PROG FILELOG HOSTS SHIFTER_IMAGE nprocpernode nprocperjob ngpuperjob

if [ $ngpupernode -eq 0 ]; then
  # CPU-only executable
  SHIFTER_IMAGE='docker:baip/compiler:aocc-slurm-pmi-spack'
  PROG="/global/common/software/m3393/vasp-tools/hosts/docker/vaspexec/vasp6.3.2_aocc_ompi_aocl_vtst_slurm_pmi"

  cat << EOF > $MPIRUN
#!/usr/bin/env bash

srun -N 1 -w \$HOSTS --exact -u -c 1 --cpu_bind=cores --mpi=pmi2 -n \$1 shifter --module=none --image=$SHIFTER_IMAGE "\${@:2}"
EOF
else
  # GPU-enabled executable
  SHIFTER_IMAGE='docker:baip/compiler:nvhpc-cuda-slurm-pmi-spack'
  PROG="/global/common/software/m3393/vasp-tools/hosts/docker/vaspexec/vasp6.3.2_nvhpc_ompi_omp_acc_vtst_slurm_pmi"

  cat << EOF > $MPIRUN
#!/usr/bin/env bash

nprocpergpu=\$((\$1/$ngpuperjob))
mempergpu=$((MEM*ngpuperjob/nnodeperjob/ngpupernode))
export OMP_NUM_THREADS=\$nprocpergpu
export OMP_STACKSIZE=512m
export OMP_PLACES=cores
export OMP_PROC_BIND=close
srun -N 1 -w \$HOSTS --exact -u -c 1 --cpu_bind=cores --mpi=pmi2 --gpus-per-node 1 --mem-per-gpu \${mempergpu}M -n $ngpuperjob shifter --module=gpu --image=$SHIFTER_IMAGE "\${@:2}"
EOF
fi

chmod +x $MPIRUN
#######################################################################
inode=-1
ijob=0
((njobspernode=nprocpernode/nprocperjob))

#>>>BEGIN<<<
cd "$ROOT/$job_dir"
[ $((ijob++ % njobspernode)) -eq 0 ] && ((inode++))
HOSTS=${NODE[inode]} ./sub-vasp.script 2>stderr 1>stdout &

#>>>END<<<

wait

exit 0
