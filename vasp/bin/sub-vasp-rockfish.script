#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=defq

#######################################################################
module rm intel gcc openmpi
module add intel/2020.2

MPIRUN='mpirun -np'
# The code files are group accessible
PROG="/data/baip/vasp-tools/hosts/rockfish/vaspexec/vasp6.1.2_ifort_impi_mkl_vtst"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
