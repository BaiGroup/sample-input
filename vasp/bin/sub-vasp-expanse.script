#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=compute

#######################################################################
module rm intel intel-mkl intel-mpi hdf5 cpu
module add cpu/0.15.4
module add intel/19.1.1.217 intel-mkl/2019.1.144 intel-mpi/2019.8.254 hdf5/1.10.6

export MKL_DEBUG_CPU_TYPE=5
export MKL_ENABLE_INSTRUCTIONS=AVX2
export I_MPI_PMI_LIBRARY=/cm/shared/apps/slurm/21.08.8/lib64/libpmi2.so

MPIRUN='srun -c 1 --cpu_bind=cores --mpi=pmi2 -n'
# The code files are group accessible
PROG="/home/baip/vasp-tools/hosts/expanse/vaspexec/vasp6.3.2_intel_impi_mkl_vtst"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
