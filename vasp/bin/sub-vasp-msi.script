#!/usr/bin/env bash

#PBS -l nodes=1:ppn=24,walltime=96:00:00
#PBS -N name
#PBS -e stderr-$PBS_JOBID
#PBS -o stdout-$PBS_JOBID

#######################################################################
module rm intel impi ompi
module add intel/2015/update3
module add impi/5.0.3.048/intel

MPIRUN='mpirun -np'

if [[ $(hostname) =~ node* ]]; then
    # Itasca
    PROG=$HOME/vasp-tools/hosts/itasca/vaspexec/vasp5.4.1_ifort_impi_mkl_vtst_vaspsol
else
    # Mesabi
    PROG=$HOME/vasp-tools/hosts/mesabi/vaspexec/vasp5.4.1_ifort_impi_mkl_vtst_vaspsol
fi

source util-pbs.sh
source sub-vasp.script

exit 0
