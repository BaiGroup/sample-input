#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=28
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=RM

#######################################################################
module rm intel nvhpc openmpi
module add openmpi/4.0.5-nvhpc20.11 nvhpc/20.11

ulimit -s unlimited
export OMP_NUM_THREADS=1
export SLURM_WHOLE=1
export NO_STOP_MESSAGE=yes

MPIRUN='mpirun -np'
PROG="$HOME/vasp-tools/hosts/bridges2/vaspexec/vasp6.1.2_pgi_ompi_vtst"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-vasp.script

exit 0
