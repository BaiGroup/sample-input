#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=shared

#######################################################################
module rm mvapich2_ib intel
module add intel/2018.1.163 intelmpi/2018.1.163

#MPIRUN='ibrun --binding-level core -np'
MPIRUN='mpirun -np'
PROG="$HOME/MCCCS/exe/topmon"

if [ "$HOSTS" ]; then
  ROOT=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
else
  WALLTIME=$(scontrol show job $SLURM_JOB_ID | gawk '/TimeLimit/{seconds=0; split($2,t1,"="); if (split(t1[2],t2,"-")==2) {seconds=t2[1]*24; t2[1]=t2[2];} split(t2[1],t3,":"); print ((seconds+t3[1])*60+t3[2])*60+t3[3]}')
  NODE=($(scontrol show hostname "$SLURM_NODELIST"))
  #echo ${NODE[@]} > tmp-$PBS_JOBID
  HOSTS=${NODE[@]}
  ROOT=$SLURM_SUBMIT_DIR
  [ -z "$SLURM_TASKS_PER_NODE" ] && SLURM_TASKS_PER_NODE=$SLURM_NTASKS_PER_NODE
  nprocpernode=$((SLURM_TASKS_PER_NODE*SLURM_CPUS_PER_TASK))
fi
#######################################################################
cd "$ROOT"
rsync_options=''
ORIGINAL_ROOT="$ROOT"
ROOT="/scratch/$USER/$SLURM_JOBID"
mkdir -p $ROOT
rsync -rltDz --stats --partial --delete --delete-excluded --force --exclude=std???.* $ORIGINAL_ROOT/ $ROOT/ &> /dev/null

kill_periodic_sync() {
  echo -n 'Killing background sync...'
  kill $sync_pid
  wait $sync_pid 2>/dev/null
  rsync -rltDz --stats --partial $rsync_options $ROOT/ $ORIGINAL_ROOT/ &> /dev/null
  rm -rf $ROOT
  echo '  killed.'
  echo
}

periodic_sync() {
  local _sleeptime=300
  [ $# -gt 0 ] && _sleeptime="$1"

  while true; do
    sleep $_sleeptime
    rsync -rltDz --stats --partial $rsync_options $ROOT/ $ORIGINAL_ROOT/ &> /dev/null
  done
}

periodic_sync &
sync_pid=$!
trap kill_periodic_sync EXIT
#######################################################################
source sub-topmon.script

exit 0
