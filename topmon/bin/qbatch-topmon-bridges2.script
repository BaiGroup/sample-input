#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=28
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=RM-shared

#######################################################################
module rm intel intelmpi
module add intel/20.4 intelmpi/20.4-intel20.4

export I_MPI_JOB_RESPECT_PROCESS_PLACEMENT=0

MPIRUN='mpirun -np'
PROG="/ocean/projects/cts190028p/MCCCS/exe/topmon"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
cat << 'EOF' > $ROOT/run_serial_job.sh
#!/usr/bin/env bash

_ijob=$1
_nprocperjob=$2

echo numactl -C +$((_ijob-1)) "${@:3}"
numactl -C +$((_ijob-1)) "${@:3}"
EOF

chmod +x $ROOT/run_serial_job.sh
#######################################################################
nprocperjob=1
((njobspernode=nprocpernode/nprocperjob))
export FILELOG HOSTS MPIRUN PROG nprocperjob

inode=-1
ijob=0

#>>>BEGIN<<<
cd "$ROOT/$job_dir"
[ $((ijob++ % njobspernode)) -eq 0 ] && ((inode++))
HOSTS=${NODE[inode]} MPIRUN="$ROOT/run_serial_job.sh $ijob" ./sub-topmon.script 2>stderr 1>stdout &

#>>>END<<<

wait

exit 0
