#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=28
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=RM-shared

#######################################################################
module rm intel intelmpi
module add intel/20.4 intelmpi/20.4-intel20.4

export I_MPI_JOB_RESPECT_PROCESS_PLACEMENT=0

MPIRUN='mpirun -np'
PROG="$HOME/MCCCS/exe/topmon"

if [ "$HOSTS" ]; then
  ROOT=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
else
  WALLTIME=$(scontrol show job $SLURM_JOB_ID | gawk '/TimeLimit/{seconds=0; split($2,t1,"="); if (split(t1[2],t2,"-")==2) {seconds=t2[1]*24; t2[1]=t2[2];} split(t2[1],t3,":"); print ((seconds+t3[1])*60+t3[2])*60+t3[3]}')
  NODE=($(scontrol show hostname "$SLURM_NODELIST"))
  #echo ${NODE[@]} > tmp-$PBS_JOBID
  HOSTS=${NODE[@]}
  ROOT=$SLURM_SUBMIT_DIR
  [ -z "$SLURM_TASKS_PER_NODE" ] && SLURM_TASKS_PER_NODE=$SLURM_NTASKS_PER_NODE
  nprocpernode=$((SLURM_TASKS_PER_NODE*SLURM_CPUS_PER_TASK))
fi
#######################################################################
cat << 'EOF' > $ROOT/run_serial_job.sh
#!/usr/bin/env bash

_ijob=$1
_nprocperjob=$2

echo numactl -C +$((_ijob-1)) "${@:3}"
numactl -C +$((_ijob-1)) "${@:3}"
EOF

chmod +x $ROOT/run_serial_job.sh
#######################################################################
cd "$ROOT"
[ -f ./util.sh ] && source util.sh

nprocperjob=1
((njobspernode=nprocpernode/nprocperjob))
nprocpernode=$nprocperjob
export MPIRUN PROG HOSTS nprocpernode

inode=-1
ijob=0

#>>>BEGIN<<<
cd "$ROOT/$job_dir"
[ $((ijob++ % njobspernode)) -eq 0 ] && ((inode++))
HOSTS=${NODE[inode]} MPIRUN="$ROOT/run_serial_job.sh $ijob" ./sub-topmon.script 2>stderr 1>stdout &

#>>>END<<<

wait

exit 0
