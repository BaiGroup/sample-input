#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=skx-normal

#######################################################################
module rm intel impi
module add intel/17.0.4 impi/17.0.3

MPIRUN='ibrun -np'

if lscpu | grep -q 'Xeon Phi' &> /dev/null; then
    # knl
    :
else
    # skx
    module add cp2k/6.1
    PROG="$(which cp2k.popt)"
    export REAL_ELPA_KERNEL='REAL_ELPA_KERNEL_AVX512_BLOCK2'
fi

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-cp2k.script

exit 0
