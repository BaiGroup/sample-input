#   local _sleeptime=300
#   [ $# -gt 0 ] && _sleeptime="$1"

#   while true; do
#     sleep $_sleeptime
#     rsync -rltDz --stats --partial $rsync_options $ROOT/ $ORIGINAL_ROOT/ &> /dev/null
#   done
# }

# periodic_sync &
