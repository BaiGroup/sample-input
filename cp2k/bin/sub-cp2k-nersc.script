#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=96:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=regular
#SBATCH --license=SCRATCH

#######################################################################
# module rm python PrgEnv-cray PrgEnv-gnu PrgEnv-intel
# module add PrgEnv-gnu
# module rm cray-libsci

MPIRUN='srun -c 1 --cpu_bind=cores -n'

if lscpu | grep -q 'Xeon Phi' &> /dev/null; then
    # knl
    module rm craype-haswell
    module add craype-mic-knl
    module use --append $HOME/tools/spack/share/spack/modules/cray-CNL-haswell
    module load intel-mkl-2018.1.163-gcc-6.3.0.knl-srgzo5e
    module load elpa-2017.05.003-gcc-6.3.0.knl-ho4ofoa
    module load libint-1.1.6-gcc-6.3.0.knl-o5euxcg
    module load libxc-3.0.0-gcc-6.3.0.knl-jot7ktm
    module load metis-5.1.0-gcc-6.3.0.knl-jyix6n3
    module load parmetis-4.0.3-gcc-6.3.0.knl-jogcsbd
    module load superlu-dist-5.2.2-gcc-6.3.0.knl-vunnbqm
    module load pexsi-0.10.2-gcc-6.3.0.knl-qylo35c
    module load gsl-2.4-gcc-6.3.0.knl-cwv2vwa
    module load zlib-1.2.11-gcc-6.3.0.knl-2gra5ij
    module load plumed-2.3.3-gcc-6.3.0.knl-7wplpfl
    module load libxsmm-1.8.1-gcc-6.3.0.knl-cs54amm
    PROG="$HOME/tools/cp2k-5.1/exe/cray-CNL-knl-gcc-mkl-xsmm/cp2k.popt"
    export REAL_ELPA_KERNEL='REAL_ELPA_KERNEL_AVX512_BLOCK2'
elif lscpu | grep -q ' v3 @ ' &> /dev/null; then
    # cori
    # module use --append $HOME/tools/spack/share/spack/modules/cray-CNL-haswell
    # module load intel-mkl-2018.1.163-gcc-6.3.0.cori-rzfbtze
    # module load elpa-2016.11.001.pre-gcc-6.3.0.cori-oacqzfr
    # module load libint-1.1.6-gcc-6.3.0.cori-ifo7zhv
    # module load libxc-3.0.0-gcc-6.3.0.cori-4ihmdez
    # module load metis-5.1.0-gcc-6.3.0.cori-l2ww4t4
    # module load parmetis-4.0.3-gcc-6.3.0.cori-vkrbmrm
    # module load superlu-dist-5.2.2-gcc-6.3.0.cori-2rrjg6o
    # module load pexsi-0.10.2-gcc-6.3.0.cori-inuui7b
    # module load gsl-2.4-gcc-6.3.0.cori-c667kbw
    # module load zlib-1.2.11-gcc-6.3.0.cori-qwajphz
    # module load plumed-2.3.3-gcc-6.3.0.cori-xnkreu3
    # PROG="$HOME/tools/cp2k-5.1/exe/cray-CNL-haswell-gcc-mkl/cp2k.popt"
    module add cp2k/6.1
    PROG="$(which cp2k.popt)"
    export REAL_ELPA_KERNEL='REAL_ELPA_KERNEL_AVX2_BLOCK2'
else
    # edison
    module use --append $HOME/tools/spack/share/spack/modules/cray-CNL-ivybridge
    module load intel-mkl-2018.1.163-gcc-6.3.0.edison-zstcksx
    module load elpa-2016.11.001.pre-gcc-6.3.0.edison-cp6n3fy
    module load libint-1.1.6-gcc-6.3.0.edison-pqs5o3a
    module load libxc-3.0.0-gcc-6.3.0.edison-hkblt4o
    module load metis-5.1.0-gcc-6.3.0.edison-vppyxld
    module load parmetis-4.0.3-gcc-6.3.0.edison-qywnqjq
    module load superlu-dist-5.2.2-gcc-6.3.0.edison-3azwtht
    module load pexsi-0.10.2-gcc-6.3.0.edison-x6nhpss
    module load gsl-2.4-gcc-6.3.0.edison-qqgkju3
    module load zlib-1.2.11-gcc-6.3.0.edison-sy2fq5q
    module load plumed-2.3.3-gcc-6.3.0.edison-ywfqgrr
    PROG="$HOME/tools/cp2k-5.1/exe/cray-CNL-ivybridge-gcc-mkl/cp2k.popt"
    export REAL_ELPA_KERNEL='REAL_ELPA_KERNEL_AVX_BLOCK2'
fi

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-cp2k.script

exit 0
