#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=24
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=96:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=E5_2650v4

#######################################################################
module add gaussian/g16.a03
PROG="$(which g16)"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
rsync_options='--exclude=.*.chk.*'
ORIGINAL_ROOT="$ROOT"
ROOT="/state/partition1/$USER/$$"
mkdir -p $ROOT
cd "$ROOT"
rsync -rltDz --stats --partial --delete --delete-excluded --force --exclude=std???.* $ORIGINAL_ROOT/ $ROOT/ &> /dev/null

kill_periodic_sync() {
    echo -n 'Killing background sync...'
    kill $sync_pid
    wait $sync_pid 2>/dev/null
    rsync -rltDz --stats --partial $rsync_options $ROOT/ $ORIGINAL_ROOT/ &> /dev/null
    rm -rf $ROOT
    echo '  killed.'
    echo
}

periodic_sync() {
    local _sleeptime=300
    [ $# -gt 0 ] && _sleeptime="$1"

    while true; do
        sleep $_sleeptime
        rsync -rltDz --stats --partial $rsync_options $ROOT/ $ORIGINAL_ROOT/ &> /dev/null
    done
}

periodic_sync &
sync_pid=$!
trap kill_periodic_sync EXIT
#######################################################################
source sub-gaussian.script

exit 0
