#!/usr/bin/env bash

#PBS -l nodes=1:ppn=24,walltime=96:00:00
#PBS -N name
#PBS -e stderr-$PBS_JOBID
#PBS -o stdout-$PBS_JOBID

#######################################################################
module rm python ase gaussian
module add python/conda3
module add ase/git

if [[ $(hostname) =~ node* ]]; then
    # Itasca
    module add gaussian/g16.a03
else
    # Mesabi
    module add gaussian/g16.a03
fi
export PYTHONPATH="~/ase-mc${PYTHONPATH:+:$PYTHONPATH}"

MPIRUN='mpirun -np'
PROG="$(which g16)"

source util-pbs.sh
source sub-neb.script

exit 0
