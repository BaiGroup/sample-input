#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=28
#SBATCH --cpus-per-task=1
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=RM

#######################################################################
module rm anaconda3 gaussian
module add anaconda3/2020.11
module add gaussian/G16_RevC01

export GAUSS_EXEDIR="$(dirname $PROG)"
export I_MPI_JOB_RESPECT_PROCESS_PLACEMENT=0

MPIRUN='mpirun -np'
PROG="$(which g16)"

if [ "$HOSTS" ]; then
  ROOT=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
else
  WALLTIME=$(scontrol show job $SLURM_JOB_ID | gawk '/TimeLimit/{seconds=0; split($2,t1,"="); if (split(t1[2],t2,"-")==2) {seconds=t2[1]*24; t2[1]=t2[2];} split(t2[1],t3,":"); print ((seconds+t3[1])*60+t3[2])*60+t3[3]}')
  MEM=$(scontrol show job $SLURM_JOB_ID|gawk '/mem=/{split($1,m1,","); split(m1[2],m2,"="); print m2[2]}'|sed 's/M//')
  NODE=($(scontrol show hostname "$SLURM_NODELIST"))
  #echo ${NODE[@]} > hosts.txt
  HOSTS=${NODE[@]}
  ROOT=$SLURM_SUBMIT_DIR
  [ -z "$SLURM_TASKS_PER_NODE" ] && SLURM_TASKS_PER_NODE=$SLURM_NTASKS_PER_NODE
  nprocpernode=$((SLURM_TASKS_PER_NODE*SLURM_CPUS_PER_TASK))
fi
#######################################################################
cd "$ROOT"
source sub-neb.script

exit 0
