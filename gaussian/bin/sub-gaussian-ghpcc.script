#!/usr/bin/env bash

#BSUB -n 16
#BSUB -W 720:00
#BSUB -J name
#BSUB -e stderr-$LSB_JOBID
#BSUB -o stdout-$LSB_JOBID
#BSUB -L bash

#######################################################################
module add gaussian/g16.a03
PROG="$(which g16)"

CPUINFO=$(lscpu | grep 'Model name:')
if [[ "${CPUINFO}" =~ "Gold 6141" ]]; then
    # Intel(R) Xeon(R) Gold 6140 CPU @ 2.30GHz
    :
elif [[ "${CPUINFO}" =~ "E5-2650 v3" ]]; then
    # Intel(R) Xeon(R) CPU E5-2650 v3 @ 2.30GHz
    :
elif [[ "${CPUINFO}" =~ "E5-2650 0" ]]; then
    # Intel(R) Xeon(R) CPU E5-2650 0 @ 2.00GHz
    :
elif [[ "${CPUINFO}" =~ "6380" ]]; then
    # AMD Opteron(tm) Processor 6380 @ 2.5GHz
    :
elif [[ "${CPUINFO}" =~ "6378" ]]; then
    # AMD Opteron(tm) Processor 6378 @ 2.4GHz
    :
elif [[ "${CPUINFO}" =~ "6278" ]]; then
    # AMD Opteron(tm) Processor 6278 @ 2.4GHz
    :
else
    # Unknown CPU architecture
    :
fi

source util-lsf.sh
source sub-gaussian.script

exit 0
