#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=24
#SBATCH --cpus-per-task=1
#SBATCH --mem=0
#SBATCH --time=96:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=E5_2650v4

#######################################################################
module rm python ase gaussian
module add python/conda3
module add ase/git
module add gaussian/g16.a03

MPIRUN='mpirun -np'
PROG="$(which g16)"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
rsync_options='--exclude=.*.chk.*'
SCRATCH="/state/partition1/$USER/$$"

echo "Initial rsync..."
for (( hidx=0; hidx<${#NODE[@]}; hidx++ )); do
  \ssh ${NODE[hidx]} "mkdir -p $SCRATCH && \rsync -rltDz --stats --partial --delete --delete-excluded --force --exclude=std???.* $ROOT/${hidx}-* $SCRATCH/" &> /dev/null &
done
wait

kill_periodic_sync() {
  echo -n 'Killing background sync...'
  kill $sync_pid
  wait $sync_pid 2>/dev/null
  for (( hidx=0; hidx<${#NODE[@]}; hidx++ )); do
    \ssh ${NODE[hidx]} "\rsync -rltDz --stats --partial $rsync_options $SCRATCH/ $ROOT/" &> /dev/null &
  done
  wait
  # rm -rf $ROOT
  echo '  killed.'
  echo
}

periodic_sync() {
  local _sleeptime=300
  [ $# -gt 0 ] && _sleeptime="$1"

  while true; do
    sleep $_sleeptime
    for (( hidx=0; hidx<${#NODE[@]}; hidx++ )); do
      \ssh ${NODE[hidx]} "\rsync -rltDz --stats --partial $rsync_options $SCRATCH/ $ROOT/" &> /dev/null &
    done
    wait
  done
}

periodic_sync &
sync_pid=$!
trap kill_periodic_sync EXIT
#######################################################################
tmp_options="--tmp $SCRATCH"
source sub-neb.script

exit 0
