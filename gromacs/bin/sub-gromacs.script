#!/usr/bin/env bash

#######################################################################
run_gromacs() {
    local FCUR=$1
    echo "$FCUR: " >> $FILELOG

    [ -z "$nthreadperrank" ] && nthreadperrank=1  # choose according to benchmark results
    # calculate MPI ranks based on total cores requested and OpenMP threads
    while [ $((nprocperjob%nthreadperrank)) -ne 0 ]; do
      ((nthreadperrank--))
    done
    nrankperjob=$((nprocperjob/nthreadperrank))

    if [ $ngpupernode -eq 0 ]; then
        # CPU job
        /usr/bin/time -ao $FILELOG $MPIRUN $nrankperjob $PROG mdrun -ntomp $nthreadperrank -deffnm $FCUR -cpi state.cpt -cpt 15 2>$FCUR.err 1>$FCUR.out || exit -1
    else
        # GPU job, using thread MPI
        [ "$nrankperjob" -gt 1 ] && options="-ntmpi $nrankperjob -npme 1"
        /usr/bin/time -ao $FILELOG $MPIRUN $nprocperjob $PROG mdrun $options -ntomp $nthreadperrank -nb gpu -pme gpu -bonded gpu -deffnm $FCUR -cpi state.cpt -cpt 15 2>$FCUR.err 1>$FCUR.out || exit -1
    fi
}

get_latest_tpr() {
    local _prefix="$1"
    local _suffix=".tpr"
    local _imax=0
    local _i
    for f in "${_prefix}"*"${_suffix}"; do
        if [ -e "$f" ]; then
            _i="${f/${_prefix}/}"
            _i="${_i%${_suffix}}"
            [ "$_i" -gt "$_imax" ] && _imax="$_i"
        fi
    done
    echo $_imax
}
#######################################################################
if [ -e 'jobs' ]; then
    for stage in $(cat jobs); do
        run_gromacs $stage
    done
else
    for stage in prod equil; do
        i=$(get_latest_tpr "$stage")
        [ "$i" -ne 0 ] && break
    done
    run_gromacs "${stage}${i}"
fi
