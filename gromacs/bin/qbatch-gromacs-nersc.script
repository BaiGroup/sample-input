#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
##SBATCH --mem=0
#SBATCH --time=96:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=regular
#SBATCH --license=SCRATCH

#######################################################################
module rm python craype-mic-knl craype-haswell cray-mpich PrgEnv-intel
module add PrgEnv-intel/6.0.5 cray-mpich/7.7.6
module rm cray-libsci

MPIRUN='srun -c 1 --cpu_bind=cores -n'

if lscpu | grep -q 'Xeon Phi' &> /dev/null; then
    # knl
    module add craype-mic-knl
    BASEDIR="/global/common/software/m3393/tools/gromacs-2019.3/intel-double-impi-mkl-knl"
elif lscpu | grep -q ' v3 @ ' &> /dev/null; then
    # cori
    module add craype-haswell
    BASEDIR="/global/common/software/m3393/tools/gromacs-2019.3/intel-double-impi-mkl"
else
    # edison
    :
fi

export PATH="$BASEDIR/bin:$PATH"
export LD_LIBRARY_PATH="$BASEDIR/lib:$LD_LIBRARY_PATH"
PROG="$BASEDIR/bin/gmx_mpi_d"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
nprocperjob=2
export FILELOG HOSTS MPIRUN PROG nprocperjob

inode=-1
ijob=0
((njobspernode=nprocpernode/nprocperjob))

#>>>BEGIN<<<
cd "$ROOT/$job_dir"
[ $((ijob++ % njobspernode)) -eq 0 ] && ((inode++))
HOSTS=${NODE[inode]} MPIRUN='srun -w ${NODE[inode]} -c 1 --cpu_bind=cores -n' ./sub-gromacs.script 2>stderr 1>stdout &

#>>>END<<<

wait

exit 0
