#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
##SBATCH --mem=0
#SBATCH --time=24:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=cpu
#SBATCH --account=bbwx-delta-cpu
#SBATCH --constraint="scratch"

#######################################################################
sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
MPIRUN="$ROOT/run_singularity.sh"
# The code files are group accessible
SINGULARITY_IMAGE='/taiga/nsf/delta/bbwx/shared/tools/singularity/gromacs_2023.2.sif'
PROG='/usr/local/gromacs/avx2_256/bin/gmx'

if [ $ngpupernode -eq 0 ]; then
  # CPU-only executable
  cat << EOF > $MPIRUN
#!/usr/bin/env bash

srun -c 1 --cpu_bind=cores --mpi=pmi2 -n \$1 singularity exec --bind /delta,/scratch,/taiga/nsf/delta/bbwx $SINGULARITY_IMAGE "\${@:2}"
EOF
else
  # GPU-enabled executable

  cat << EOF > $MPIRUN
#!/usr/bin/env bash

srun -c \$1 --cpu_bind=cores --mpi=pmi2 -n 1 singularity exec --nv --bind /delta,/scratch,/taiga/nsf/delta/bbwx $SINGULARITY_IMAGE "\${@:2}"
EOF
fi

chmod +x $MPIRUN
#######################################################################
source sub-gromacs.script

exit 0
