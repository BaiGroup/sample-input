#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=compute

#######################################################################
module rm mvapich2_ib intel openmpi_ib gnu
module add gnu/7.2.0

#module add openmpi_ib/1.8.4
#BASEDIR="$HOME/tools/gromacs-2019.3/gcc-double-ompi-fftw"
#MPIRUN='ibrun --binding-level core -np'

module add intelmpi/2018.1.163
BASEDIR="$HOME/tools/gromacs-2019.3/gcc-double-impi-fftw"

#module add intel/2016.3.210 intelmpi/2016.3.210
#BASEDIR="$HOME/tools/gromacs-2018.7/intel-double-impi-mkl"

MPIRUN='mpirun -np'
export PATH="$BASEDIR/bin:$PATH"
export LD_LIBRARY_PATH="$BASEDIR/lib:$LD_LIBRARY_PATH"
PROG="$BASEDIR/bin/gmx_mpi_d"

if [ "$HOSTS" ]; then
    ROOT=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
else
    WALLTIME=$(scontrol show job $SLURM_JOB_ID | gawk '/TimeLimit/{seconds=0; split($2,t1,"="); if (split(t1[2],t2,"-")==2) {seconds=t2[1]*24; t2[1]=t2[2];} split(t2[1],t3,":"); print ((seconds+t3[1])*60+t3[2])*60+t3[3]}')
    NODE=($(scontrol show hostname "$SLURM_NODELIST"))
    #echo ${NODE[@]} > tmp-$PBS_JOBID
    HOSTS=${NODE[@]}
    ROOT=$SLURM_SUBMIT_DIR
  [ -z "$SLURM_TASKS_PER_NODE" ] && SLURM_TASKS_PER_NODE=$SLURM_NTASKS_PER_NODE
    nprocpernode=$((SLURM_TASKS_PER_NODE*SLURM_CPUS_PER_TASK))
fi
#######################################################################
cd "$ROOT"
source sub-gromacs.script

exit 0
