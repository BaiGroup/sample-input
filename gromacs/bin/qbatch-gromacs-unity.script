#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=40
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=cpu

#######################################################################
source /etc/profile
ulimit -s unlimited
[ -d "$HOME/privatemodules"  ] && module use --append ~/privatemodules
module rm parallel_studio_xe gcc
module add parallel_studio_xe/2020.2 gcc/10.2.0

export I_MPI_JOB_RESPECT_PROCESS_PLACEMENT=0

MPIRUN='mpirun -np'
BASEDIR="$HOME/tools/gromacs-2019.3/gcc-double-impi-fftw"
export PATH="$BASEDIR/bin:$PATH"
export LD_LIBRARY_PATH="$BASEDIR/lib:$LD_LIBRARY_PATH"
PROG="$BASEDIR/bin/gmx_mpi_d"


if [ "$HOSTS" ]; then
  ROOT=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
else
  WALLTIME=$(scontrol show job $SLURM_JOB_ID | gawk '/TimeLimit/{seconds=0; split($2,t1,"="); if (split(t1[2],t2,"-")==2) {seconds=t2[1]*24; t2[1]=t2[2];} split(t2[1],t3,":"); print ((seconds+t3[1])*60+t3[2])*60+t3[3]}')
  NODE=($(scontrol show hostname "$SLURM_NODELIST"))
  #echo ${NODE[@]} > tmp-$PBS_JOBID
  HOSTS=${NODE[@]}
  ROOT=$SLURM_SUBMIT_DIR
  hyperthreading=$(scontrol show node ${NODE[0]} | gawk '/ThreadsPerCore=/{split($2,hyperthreading,"="); print hyperthreading[2]}')
  [ -z "$SLURM_TASKS_PER_NODE" ] && SLURM_TASKS_PER_NODE=$SLURM_NTASKS_PER_NODE
  nprocpernode=$((SLURM_TASKS_PER_NODE*SLURM_CPUS_PER_TASK/hyperthreading))
fi
#######################################################################
cd $ROOT
[ -f util.sh ] && source util.sh
nprocperjob=1
export MPIRUN PROG HOSTS nprocpernode nprocperjob

inode=-1
ijob=0
((njobspernode=nprocpernode/nprocperjob))

#>>>BEGIN<<<
cd "$ROOT/$job_dir"
proc1="$(( (ijob*nprocperjob) % nprocpernode))"
proc2="$((proc1 + nprocperjob - 1))"
[ $((ijob++ % njobspernode)) -eq 0 ] && ((inode++))
nnodeperjob=1 nprocpernode=1 HOSTS=${NODE[inode]} MPIRUN="srun -c 1 --cpu_bind=cores -w ${NODE[inode]} -n" ./sub-gromacs.script 2>stderr 1>stdout &
#nnodeperjob=1 nprocpernode=1 HOSTS=${NODE[inode]} MPIRUN="mpiexec -genv I_MPI_PIN_PROCESSOR_LIST=${proc1}-${proc2} -hosts ${NODE[inode]} -np" ./sub-gromacs.script 2>stderr 1>stdout &

#>>>END<<<

wait

exit 0
