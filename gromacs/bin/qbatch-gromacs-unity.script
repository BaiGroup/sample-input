#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=40
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=cpu

#######################################################################
source /etc/profile
ulimit -s unlimited
[ -d '/work/pengbai_umass_edu/unitymodules' ] && module use --append /work/pengbai_umass_edu/unitymodules
module rm parallel_studio_xe gcc
module add parallel_studio_xe/2020.2 gcc/10.2.0

export I_MPI_JOB_RESPECT_PROCESS_PLACEMENT=0

MPIRUN='mpirun -np'
# The code files are group accessible
BASEDIR="/work/pengbai_umass_edu/tools/gromacs-2019.3/gcc-double-impi-fftw"
export PATH="$BASEDIR/bin:$PATH"
export LD_LIBRARY_PATH="$BASEDIR/lib:$LD_LIBRARY_PATH"
PROG="$BASEDIR/bin/gmx_mpi_d"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
#######################################################################
nprocperjob=1
export FILELOG HOSTS MPIRUN PROG nnodeperjob nprocperjob nprocpernode

inode=-1
ijob=0
((njobspernode=nprocpernode/nprocperjob))

#>>>BEGIN<<<
cd "$ROOT/$job_dir"
proc1="$(( (ijob*nprocperjob) % nprocpernode))"
proc2="$((proc1 + nprocperjob - 1))"
[ $((ijob++ % njobspernode)) -eq 0 ] && ((inode++))
nnodeperjob=1 nprocpernode=1 HOSTS=${NODE[inode]} MPIRUN="srun -w ${NODE[inode]} -c 1 --cpu_bind=cores -n" ./sub-gromacs.script 2>stderr 1>stdout &
#nnodeperjob=1 nprocpernode=1 HOSTS=${NODE[inode]} MPIRUN="mpiexec -genv I_MPI_PIN_PROCESSOR_LIST=${proc1}-${proc2} -hosts ${NODE[inode]} -np" ./sub-gromacs.script 2>stderr 1>stdout &

#>>>END<<<

wait

exit 0
