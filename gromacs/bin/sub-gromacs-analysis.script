#!/usr/bin/env bash

#######################################################################
FILELOG=log
if [ -z "$nprocperjob" ]; then
    nnodeperjob=$(echo $HOSTS|wc -w) #$PBS_NUM_NODES or $SLURM_NNODES
    nprocperjob=$((nnodeperjob*nprocpernode))
    source util.sh
fi
HOSTS=${HOSTS// /,}
#######################################################################
run_analysis() {
    local FCUR=$1
    echo "$FCUR: " >> $FILELOG
    export OMP_NUM_THREADS=$nprocpernode

    /usr/bin/time -ao $FILELOG $MPIRUN $nnodeperjob $PROG dos -f $FCUR.trr -s $FCUR.tpr -dos dos-$FCUR.xvg -g dos-$FCUR.log -vacf vac-$FCUR.xvg -mvacf mvac-$FCUR.xvg -nonormalize < ./g_dos.input 2> dos-$FCUR.err 1>dos-$FCUR.out || exit -1

    /usr/bin/time -ao $FILELOG $MPIRUN $nnodeperjob $PROG energy -f $FCUR.edr -o ener-$FCUR.xvg < ./g_energy.input 2>ener-$FCUR.err 1>ener-$FCUR.log || exit -1
}

get_latest_edr() {
    local _prefix="$1"
    local _suffix=".edr"
    local _imax=0
    local _i
    for f in "${_prefix}"*"${_suffix}"; do
        if [ -e "$f" ]; then
            _i="${f/${_prefix}/}"
            _i="${_i%${_suffix}}"
            [ "$_i" -gt "$_imax" ] && _imax="$_i"
        fi
    done
    echo $_imax
}
#######################################################################
echo "Hostname: $(hostname);  ROOT: $(pwd)"
echo "MPIRUN: $MPIRUN"
echo "Executable: $PROG"
echo "nprocpernode: $nprocpernode; nnodeperjob: $nnodeperjob; SLURM_CPUS_PER_TASK: $SLURM_CPUS_PER_TASK; SLURM_TASKS_PER_NODE: $SLURM_TASKS_PER_NODE"
echo "Hosts: $HOSTS"
echo

if [ -e 'jobs' ]; then
    for stage in $(cat jobs); do
        run_analysis $stage
    done
else
    for stage in prod equil; do
        i=$(get_latest_edr "$stage")
        [ "$i" -ne 0 ] && break
    done
    run_analysis "${stage}${i}"
fi
