#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=compute

#######################################################################
module rm gcc intel-mpi
module add gcc/10.2.0
module add intel-mpi/2019.8.254

export MKL_DEBUG_CPU_TYPE=5
export MKL_ENABLE_INSTRUCTIONS=AVX2

MPIRUN='mpirun -np'
BASEDIR="$HOME/tools/gromacs-2019.6/gcc-double-impi-fftw"
export PATH="$BASEDIR/bin:$PATH"
export LD_LIBRARY_PATH="$BASEDIR/lib:$LD_LIBRARY_PATH"
PROG="$BASEDIR/bin/gmx_mpi_d"

sub_script=$(scontrol show job $SLURM_JOB_ID | gawk '/Command=/{split($1,sf,"="); print sf[2]}')
asset_dir=$(dirname "$sub_script")
source $asset_dir/util-slurm.sh
source sub-gromacs.script

exit 0
