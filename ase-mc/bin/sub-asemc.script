#!/usr/bin/env bash

#######################################################################
RESTART_DB='restart.db'
# continue simulation
cont() {
    [ -e "$RESTART_DB" ] && echo "-c $RESTART_DB"
}

get_next_backup() {
    local _suffix="$1"
    local _imax=0
    local _i
    for f in "${_suffix}"*'.db'; do
        if [ -e "$f" ]; then
            _i="${f#${_suffix}}"
            _i="${_i%.db}"
            [ "$_i" -gt "$_imax" ] && _imax="$_i"
        fi
    done
    echo $((_imax+1))
}

run_asemc() {
    local FCUR="$1"
    echo "$FCUR: " >> $FILELOG

    # set temperature from directory path
    temp=$(echo $PWD|/bin/grep -o -E "[0-9]+K"|sed "s/K//")
    options="--temp $temp"

    /usr/bin/time -ao $FILELOG $MPIRUN $nprocperjob $PROG $(cont) $options >>mc.out 2>>mc.err

    mv -f mc.out $FCUR.out
    mv -f mc.err $FCUR.err
    mv -f mc.db $FCUR.db
    mv -f mc.chk $FCUR.chk
    ln -sf $FCUR.db $RESTART_DB
}
#######################################################################
if [ -e 'jobs' ]; then
    for stage in $(cat jobs); do
        run_asemc $stage
    done
else
    for stage in prod equil; do
        i=$(get_next_backup "$stage")
        [ "$i" -ne 1 ] && break
    done
    run_asemc "${stage}${i}"
fi
