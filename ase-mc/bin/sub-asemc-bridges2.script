#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=28
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=RM-shared

#######################################################################
module rm intel intelmpi anaconda3
module add intel/20.4 intelmpi/20.4-intel20.4 anaconda3/2020.11
source activate conda3.9

export MKL_DEBUG_CPU_TYPE=5
export MKL_ENABLE_INSTRUCTIONS=AVX2
export I_MPI_JOB_RESPECT_PROCESS_PLACEMENT=0

export PYTHONPATH="$HOME/MCCCS/exe:$HOME/tools/lammps/intel-impi-mkl/lib/python3.9/site-packages${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$HOME/MCCCS/exe:$HOME/tools/lammps/intel-impi-mkl/lib64:$HOME/.conda/envs/conda3.9/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

MPIRUN='mpirun -np'

if [ "$HOSTS" ]; then
  ROOT=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
else
  WALLTIME=$(scontrol show job $SLURM_JOB_ID | gawk '/TimeLimit/{seconds=0; split($2,t1,"="); if (split(t1[2],t2,"-")==2) {seconds=t2[1]*24; t2[1]=t2[2];} split(t2[1],t3,":"); print ((seconds+t3[1])*60+t3[2])*60+t3[3]}')
  NODE=($(scontrol show hostname "$SLURM_NODELIST"))
  #echo ${NODE[@]} > tmp-$PBS_JOBID
  HOSTS=${NODE[@]}
  ROOT=$SLURM_SUBMIT_DIR
  nprocpernode=$((SLURM_NTASKS_PER_NODE*SLURM_CPUS_PER_TASK))
fi
#######################################################################
cd "$ROOT"
source sub-asemc.script

exit 0
