#!/usr/bin/env bash

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=24
##SBATCH --mem=0
#SBATCH --time=48:00:00
#SBATCH --job-name=name
#SBATCH --output stdout.%j
#SBATCH --error stderr.%j
#SBATCH --partition=shared

#######################################################################
module rm intel
module add intel/19.1.1.217 intel-mkl/2019.1.144 intel-mpi/2019.8.254

export MKL_DEBUG_CPU_TYPE=5
export MKL_ENABLE_INSTRUCTIONS=AVX2

source $HOME/tools/conda/bin/activate conda3.9

export PYTHONPATH="$HOME/MCCCS/exe:$HOME/tools/lammps/intel-impi-mkl/lib/python3.9/site-packages${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$HOME/MCCCS/exe:$HOME/tools/lammps/intel-impi-mkl/lib64:$HOME/tools/conda/envs/conda3.9/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

#MPIRUN='ibrun --binding-level core -np'
MPIRUN='mpirun -np'

if [ "$HOSTS" ]; then
  ROOT=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
else
  WALLTIME=$(scontrol show job $SLURM_JOB_ID | gawk '/TimeLimit/{seconds=0; split($2,t1,"="); if (split(t1[2],t2,"-")==2) {seconds=t2[1]*24; t2[1]=t2[2];} split(t2[1],t3,":"); print ((seconds+t3[1])*60+t3[2])*60+t3[3]}')
  NODE=($(scontrol show hostname "$SLURM_NODELIST"))
  #echo ${NODE[@]} > tmp-$PBS_JOBID
  HOSTS=${NODE[@]}
  ROOT=$SLURM_SUBMIT_DIR
  [ -z "$SLURM_TASKS_PER_NODE" ] && SLURM_TASKS_PER_NODE=$SLURM_NTASKS_PER_NODE
  nprocpernode=$((SLURM_TASKS_PER_NODE*SLURM_CPUS_PER_TASK))
fi
#######################################################################
cd "$ROOT"
source sub-asemc.script

exit 0
